# Clave solo del servidor. Sin ella funcionan lecturas, diagnóstico y repasos.
ENGLISH_AI_API_KEY=
ENGLISH_AI_MODEL=gpt-4.1-mini
# Obligatorio antes de exponer la app fuera de un entorno privado.
APP_ACCESS_TOKEN=
